<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AssemblyName>ManagedBass.Tests</AssemblyName>
        <RootNamespace>ManagedBass.Tests</RootNamespace>
    </PropertyGroup>

    <!--
      Natives for the HOST platform only, from eng/fetch-natives.sh output. Override with -p:NativesPlatform=<name>.
      NOTE: never glob artifacts/natives/** - android and linux both produce libbass.so and glob order would pick the winner.
    -->
    <PropertyGroup>
        <NativesPlatform Condition="'$(NativesPlatform)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">windows</NativesPlatform>
        <NativesPlatform Condition="'$(NativesPlatform)' == '' And $([MSBuild]::IsOSPlatform('OSX'))">osx</NativesPlatform>
        <NativesPlatform Condition="'$(NativesPlatform)' == ''">linux</NativesPlatform>
        <NativesDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'artifacts', 'natives', '$(NativesPlatform)'))</NativesDirectory>
    </PropertyGroup>

    <ItemGroup Condition="Exists('$(NativesDirectory)')">
        <!-- Non-recursive: only the loose shared libraries, so ios/catalyst bundle contents can never be flattened in. -->
        <None Include="$(NativesDirectory)*" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Bass\Portable\Bass.csproj" />
        <ProjectReference Include="..\..\src\AddOns\BassFlac\BassFlac.csproj" />
    </ItemGroup>

</Project>
