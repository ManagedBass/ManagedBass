<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AssemblyName>ManagedBass.Tests</AssemblyName>
        <RootNamespace>ManagedBass.Tests</RootNamespace>
    </PropertyGroup>

    <!-- Natives for the HOST platform only; fetched on demand by the import below. Override with -p:BassNativesPlatform=<name>. -->
    <PropertyGroup>
        <BassNativesPlatform Condition="'$(BassNativesPlatform)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">windows</BassNativesPlatform>
        <BassNativesPlatform Condition="'$(BassNativesPlatform)' == '' And $([MSBuild]::IsOSPlatform('OSX'))">osx</BassNativesPlatform>
        <BassNativesPlatform Condition="'$(BassNativesPlatform)' == ''">linux</BassNativesPlatform>
        <BassNativesCopyToOutput>true</BassNativesCopyToOutput>
    </PropertyGroup>

    <Import Project="../../eng/FetchNatives/FetchNatives.targets" />

    <ItemGroup>
        <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Bass\Portable\Bass.csproj" />
        <ProjectReference Include="..\..\src\AddOns\BassFlac\BassFlac.csproj" />
        <ProjectReference Include="..\..\src\AddOns\BassEnc\Portable\BassEnc.csproj" />
    </ItemGroup>

</Project>
