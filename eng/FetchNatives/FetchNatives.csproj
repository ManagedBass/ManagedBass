<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Downloads the BASS natives listed in eng/bass-manifest.json. Run by FetchNatives.targets during the
      build of anything that needs natives; see eng/README.md for the command to run it by hand.

      NOTE: deliberately has no PackageReference. It is the first thing that runs on a fresh clone, so its
      restore has to succeed against a cold NuGet cache.
    -->

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>FetchNatives</RootNamespace>
        <AssemblyName>FetchNatives</AssemblyName>
        <IsPackable>false</IsPackable>
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

</Project>
